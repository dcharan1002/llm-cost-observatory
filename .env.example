# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env — it is listed in .gitignore.

# ---------- Streaming (Phase 2) — see docs/KAFKA_SETUP.md ----------
# Where `generator live` sends events: jsonl (terminal) | kafka | landing (offline folder)
SINK=jsonl
# Aiven "Service URI", e.g. kafka-xxxx.aivencloud.com:12345
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=llm_usage
KAFKA_GROUP_ID=llm-cost-ingestion
# SSL (Aiven client certificates) | SASL_SSL | PLAINTEXT (local/CI)
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA=certs/ca.pem
KAFKA_SSL_CERT=certs/service.cert
KAFKA_SSL_KEY=certs/service.key
# Only for SASL_SSL:
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------- Generator (Phase 1) ----------
EVENTS_PER_SECOND=5
INJECT_ANOMALIES=true

# ---------- Storage ----------
DUCKDB_PATH=data/warehouse.duckdb
LANDING_DIR=data/landing
ARCHIVE_DIR=data/archive
DEAD_LETTER_DIR=data/dead_letter

# ---------- Alerts (Phase 5) ----------
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ---------- AI assistant (Phase 6) ----------
# Options: ollama | groq | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- Backend ----------
API_HOST=0.0.0.0
API_PORT=8000
